# Vercel: set these in Project Settings > Environment Variables.
# The database auth token and secrets MUST NOT use NEXT_PUBLIC_.
TURSO_DATABASE_URL=libsql://your-database-your-org.turso.io
TURSO_AUTH_TOKEN=
VOTE_HMAC_SECRET=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Comma-separated actual deployment hostnames (without https://)
TURNSTILE_ALLOWED_HOSTNAMES=example.com
# block (default): reject repeated IP+browser pairs, not IP alone.
# monitor: allow matching pairs but flag them; use if false positives occur.
# Same-IP similar devices can collide. Different networks and spoofed hints may evade the check.
# Previously stored vote hashes are not retroactively reidentified.
VOTE_MATCH_MODE=block
# Optional private administrator statistics API


# Google OAuth 2.0 web client. Register callback URL for each deployed domain.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated email allowlist for administrators.
GOOGLE_ADMIN_EMAILS=
